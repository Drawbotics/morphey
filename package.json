    "babel-loader": "^9.2.0",
    "chai": "^4.5.0",
    "mocha": "^11.1.0",
    "rimraf": "^5.0.0",
    "terser-webpack-plugin": "^5.3.0",
    "webpack": "^5.97.0",
    "webpack-cli": "^5.1.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.3",
    "diff": "^8.0.3"
  },
  "dependencies": {
    "lodash": "^4.17.21"
  }
