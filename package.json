{
  "name": "@drawbotics/morphey",
  "version": "1.6.0",
  "description": "A small utility to transform keys and values of an object using a template.",
  "main": "lib/index.js",
  "repository": "https://github.com/Drawbotics/morphey.git",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "author": "Lorenzo Ruiz <lars.bs@hotmail.com>",
  "license": "MIT",
  "files": [
    "src",
    "lib"
  ],
  "scripts": {
    "clean": "rimraf dist/",
    "build:umd": "webpack --progress --config webpack.config.js",
    "build:commonjs": "babel src --out-dir lib/",
    "build": "npm run clean && npm run build:umd && npm run build:commonjs",
    "test": "mocha --require @babel/register --reporter spec test/*",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.0",
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
